rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrappedAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "alriachybachir621@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'title', 'category', 'price', 'image'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 150
        && data.category in ['MEN', 'WOMEN', 'SALE']
        && data.price is number && data.price >= 0
        && data.image is string && data.image.size() <= 1000000;
    }

    function isValidStoreSettings(data) {
      return data.keys().hasAll(['whatsappNumber'])
        && data.whatsappNumber is string && data.whatsappNumber.size() <= 30;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public products catalog: anyone can view products, authorized admin can modify
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isBootstrappedAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == productId;
      allow update: if isBootstrappedAdmin() && isValidId(productId) && isValidProduct(incoming()) && incoming().id == existing().id;
      allow delete: if isBootstrappedAdmin() && isValidId(productId);
    }

    // Store settings (e.g. WhatsApp phone, Admin configuration)
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow create, update: if isBootstrappedAdmin() && isValidId(settingId) && isValidStoreSettings(incoming());
      allow delete: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if isBootstrappedAdmin();
    }
  }
}
